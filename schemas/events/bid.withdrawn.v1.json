{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contract.ficium.net/schemas/events/bid.withdrawn.v1.json",
  "title": "A bid is no longer open to the borrower",
  "type": "object",
  "required": [
    "bid_id",
    "request_id",
    "reason",
    "at"
  ],
  "properties": {
    "bid_id": {
      "$ref": "../common.v1.json#/$defs/uuid"
    },
    "request_id": {
      "$ref": "../common.v1.json#/$defs/uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "withdrawn",
        "expired",
        "rejected"
      ]
    },
    "at": {
      "$ref": "../common.v1.json#/$defs/timestamp"
    }
  }
}
